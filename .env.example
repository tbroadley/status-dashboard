# Google Sheet holding tasks; auth comes from the `gws` CLI, not this file
TASKS_SPREADSHEET_ID=your_spreadsheet_id
# Linear key is fetched from Bitwarden at startup; name the vault item here.
# Set LINEAR_API_KEY directly instead to bypass Bitwarden.
LINEAR_BW_ITEM=Linear API key
# Comma-separated list of GitHub organizations (preferred)
GITHUB_ORGS=METR,metr-middleman
# Or use GITHUB_ORG for a single organization (deprecated, use GITHUB_ORGS instead)
# GITHUB_ORG=METR
LINEAR_PROJECT=your_project_name
# Comma-separated list of extra repos to include in My PRs (authored or assigned, outside your orgs)
# GITHUB_EXTRA_PR_REPOS=ukgovernmentbeis/inspect_ai,meridianlabs-ai/inspect_scout
# JSON array of [repo, pr_number] pairs to hide from review requests
HIDDEN_REVIEW_REQUESTS=[]
# JSON array of team slugs to hide from review requests (e.g. ["ra-website-devs"])
BLOCKED_REVIEW_TEAMS=[]
